# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BYOK key encryption (32+ random chars). ENCRYPTION_SECRET_OLD is used during key rotation; leave empty otherwise.
ENCRYPTION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_SECRET_OLD=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Payment mode: "simulator" or "live"
PAYMENT_MODE=simulator

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
